#!name=DeepSeek 余额监控
#!desc=显示 DeepSeek API 余额；每 30 分钟后台检查一次，余额低于设定阈值时发送 Surge 通知。
#!system=ios
#!arguments=API_KEY:replace_with_your_key,PROXY_GROUP:Proxy,LOW_BALANCE:5,REMIND_HOURS:12
#!arguments-desc=API_KEY：DeepSeek 官方 API Key；PROXY_GROUP：网络失败时使用的备用策略组；LOW_BALANCE：低余额提醒阈值；REMIND_HOURS：持续低余额时重复提醒的间隔小时数。

[Panel]
DeepSeek余额监控 = title="DeepSeek 余额",content="点击刷新查询",style=info,script-name=DeepSeek余额面板V4,update-interval=1800

[Script]
DeepSeek余额面板V4 = type=generic,script-path=https://raw.githubusercontent.com/AMEKIN/Surge/refs/heads/main/scripts/deepseek-balance.js?v=20260806v4,argument=MODE=panel&API_KEY={{{API_KEY}}}&PROXY_GROUP={{{PROXY_GROUP}}}&LOW_BALANCE={{{LOW_BALANCE}}}&REMIND_HOURS={{{REMIND_HOURS}}},script-update-interval=3600,timeout=12,engine=jsc
DeepSeek余额定时检查V4 = type=cron,cronexp="*/30 * * * *",script-path=https://raw.githubusercontent.com/AMEKIN/Surge/refs/heads/main/scripts/deepseek-balance.js?v=20260806v4,argument=MODE=cron&API_KEY={{{API_KEY}}}&PROXY_GROUP={{{PROXY_GROUP}}}&LOW_BALANCE={{{LOW_BALANCE}}}&REMIND_HOURS={{{REMIND_HOURS}}},script-update-interval=3600,timeout=12,engine=jsc